# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_DISABLE_CSRF=false
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=30s
LOG_LEVEL=info
LOG_FORMAT=json

# --- Base de datos ---
# Drivers soportados: memory, postgres, mysql, sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bpmn
DB_SSLMODE=disable
# DB_FILE=./data/bpmn.db        # solo sqlite

# URL completa opcional (tiene prioridad sobre los campos DB_*; el driver se
# infiere del esquema salvo que DB_DRIVER este definido)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bpmn?sslmode=disable

DB_AUTO_MIGRATE=true
DB_ALLOW_DESTRUCTIVE=false
DB_POOL_MAX=25
DB_POOL_MIN=5
# DB_LOG_LEVEL=warn

# --- PostgreSQL password (usado por docker-compose) ---
POSTGRES_PASSWORD=postgres

# --- Auditoria ---
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE_PATH=./data/audit.jsonl

# --- IA (opcional) ---
AI_PROVIDER=openai
# AI_API_KEY=sk-your-api-key-here
# AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=60s
AI_DEFAULT_PROFILE=auto
# AI_OPENROUTER_API_KEY=sk-or-...
# AI_ANTHROPIC_API_KEY=sk-ant-...
# AI_GROQ_API_KEY=gsk_...
# AI_EXTRA_PROVIDERS=name:key:url

AI_CACHE_ENABLED=false
AI_CACHE_TTL=5m
AI_CACHE_TYPE=memory
# AI_REDIS_URL=redis://localhost:6379/0
