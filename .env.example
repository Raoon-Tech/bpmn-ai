# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_DISABLE_CSRF=false
# GRPC_ENABLED=true
# GRPC_PORT=9090
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=30s
LOG_LEVEL=info
LOG_FORMAT=json

# --- Base de datos ---
# Drivers soportados: memory, postgres, mysql, sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bpmn
DB_SSLMODE=disable
# DB_FILE=./data/bpmn.db        # solo sqlite

# URL completa opcional (tiene prioridad sobre los campos DB_*; el driver se
# infiere del esquema salvo que DB_DRIVER este definido)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bpmn?sslmode=disable

DB_AUTO_MIGRATE=true
DB_ALLOW_DESTRUCTIVE=false
DB_POOL_MAX=25
DB_POOL_MIN=5
# DB_LOG_LEVEL=warn

# --- PostgreSQL password (usado por docker-compose) ---
POSTGRES_PASSWORD=postgres

# --- Autenticacion (el motor no gestiona usuarios ni roles) ---
# Modos: none, jwt, gateway
AUTH_MODE=none
# AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://idp.example.com/
# AUTH_AUDIENCE=bpmn-engine
# AUTH_USER_CLAIM=sub
# AUTH_ROLES_CLAIM=roles
# AUTH_TENANT_CLAIM=tenant_id
# AUTH_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1
# AUTH_ENFORCE_TASK_ROLES=false

# --- Webhooks salientes ---
# WEBHOOK_URL=https://host.example.com/bpmn/events
# WEBHOOK_SECRET=shared-secret
# WEBHOOK_EVENTS=*

# --- Auditoria ---
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE_PATH=./data/audit.jsonl

# --- IA (opcional) ---
AI_PROVIDER=openai
# AI_API_KEY=sk-your-api-key-here
# AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=60s
AI_DEFAULT_PROFILE=auto
# AI_OPENROUTER_API_KEY=sk-or-...
# AI_ANTHROPIC_API_KEY=sk-ant-...
# AI_GROQ_API_KEY=gsk_...
# AI_EXTRA_PROVIDERS=name:key:url

AI_CACHE_ENABLED=false
AI_CACHE_TTL=5m
AI_CACHE_TYPE=memory
# AI_REDIS_URL=redis://localhost:6379/0
